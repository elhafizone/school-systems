# Copy to .env.local for development. Never commit a filled-in copy.
# In production these are set in the Hostinger Node.js app environment, not in a file.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project URL and publishable (anon) key. Both reach the browser by design;
# they are safe to expose because every table is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-publishable-key

# Service role key. Bypasses RLS completely.
# Server-side only — must never be prefixed NEXT_PUBLIC_ and never committed.
# Used solely to provision and delete auth users on behalf of an admin.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Canonical origin of this deployment, no trailing slash.
# Staging:    https://your-subdomain.hostingersite.com
# Production: https://the-school-domain.example
# Changing domains is a change to this value plus the Supabase Auth redirect
# URLs — never a code change.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
